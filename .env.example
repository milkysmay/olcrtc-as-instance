# ── Connection (set all three to skip auto-detection) ──
# OLCRTC_PROVIDER=jitsi
# OLCRTC_TRANSPORT=datachannel
# OLCRTC_JITSI_INSTANCE=meet.egovm.ru
# OLCRTC_ROOM_ID=
# OLCRTC_CRYPTO_KEY=

# ── Network ──
# OLCRTC_DNS=8.8.8.8:53
# OLCRTC_MODE=srv

# ── SOCKS5 (client mode) ──
# OLCRTC_SOCKS_HOST=0.0.0.0
# OLCRTC_SOCKS_PORT=1080
# OLCRTC_SOCKS_USER=
# OLCRTC_SOCKS_PASS=

# ── Upstream proxy (server mode) ──
# OLCRTC_UPSTREAM_PROXY_ADDR=
# OLCRTC_UPSTREAM_PROXY_PORT=
# OLCRTC_UPSTREAM_PROXY_USER=
# OLCRTC_UPSTREAM_PROXY_PASS=

# ── Diagnostics ──
# If true, validate telemost & wbstream even when jitsi already passed.
# Purely for testing — does NOT change the selected provider.
# OLCRTC_TEST_ALL_PROVIDERS=false

# ── Misc ──
# OLCRTC_DEBUG=true
